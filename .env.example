# ========================================
# Budget Mate - Global Environment Variables
# ========================================

# Demo Mode Configuration
# Set to 'true' to enable demo mode (no database required)
# Set to 'false' for full development mode
DEMO_MODE=false

# Development Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Database Configuration (for non-Docker setup)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/budgetmate

# ========================================
# Quick Setup Instructions:
# 1. Copy this file to .env
# 2. Modify values as needed
# 3. For demo mode: set DEMO_MODE=true
# 4. For Docker: use docker-compose.yml
# ========================================