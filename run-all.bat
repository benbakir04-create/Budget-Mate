@echo off
echo Starting Budget Mate Backend and Frontend...

echo Starting Backend...
start "Budget Mate Backend" /D "%~dp0backend" cmd /k "npm run dev"

echo Waiting for Backend to start...
timeout /t 5 /nobreak >nul

echo Starting Frontend...
start "Budget Mate Frontend" /D "%~dp0frontend" cmd /k "npm run start"

echo Budget Mate is starting...
echo Backend will run on: http://localhost:5000
echo Frontend will run on: http://localhost:3000
