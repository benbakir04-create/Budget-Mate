# Normalize all text files to LF in the repository (matches .prettierrc and ESLint linebreak-style)
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.docx binary
*.xlsx binary
*.xlsm binary
*.png binary
*.jpg binary
*.svg text eol=lf
