# ========================================
# Budget Mate Backend Configuration
# ========================================

# Database Configuration
# For PostgreSQL: postgresql://username:password@localhost:5432/database_name
# For development with Docker: postgresql://postgres:password@db:5432/budgetmate
DATABASE_URL="postgresql://postgres:password@localhost:5432/budgetmate"

# JWT Configuration
# Generate strong random secrets for production
JWT_SECRET="your-super-secret-jwt-key-change-in-production-123456789"
JWT_REFRESH_SECRET="your-refresh-token-secret-987654321"
JWT_EXPIRE="24h"
JWT_REFRESH_EXPIRE="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# CORS Configuration
# Frontend URL for CORS policy
FRONTEND_URL="http://localhost:3000"

# ========================================
# Quick Setup for Development:
# 1. Install PostgreSQL
# 2. Create database: budgetmate
# 3. Update DATABASE_URL with your credentials
# 4. Run: npm run prisma:migrate
# 5. Run: npm run prisma:seed
# ========================================


