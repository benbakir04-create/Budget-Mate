generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  role         String        @default("owner") // "owner" or "partner"
  parentId     String?       // ربط حساب الشريك بالحساب الرئيسي
  currency     String        @default("SAR")
  language     String        @default("ar")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  funds        JointFund[]
  
  parent       User?         @relation("UserToPartner", fields: [parentId], references: [id], onDelete: Cascade)
  partners     User[]        @relation("UserToPartner")
}

model JointFund {
  id           String          @id @default(uuid())
  name         String          // e.g., "مصروف البيت الرئيسي"
  balance      Decimal         @db.Decimal(12, 2) @default(0.00)
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  orders       ShoppingOrder[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Category {
  id           String        @id @default(uuid())
  name         String
  nameAr       String
  icon         String
  color        String
  type         String        // 'income' or 'expense'
  userId       String
  isPrivate    Boolean       @default(false) // خصوصية المالك: إذا كانت true لا يراها الشريك نهائياً
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
}

model Transaction {
  id          String     @id @default(uuid())
  amount      Decimal    @db.Decimal(12, 2)
  type        String     // 'income' or 'expense'
  description String     @default("")
  date        DateTime   @default(now())
  userId      String
  categoryId  String
  fundId      String?    // فارغ للمصاريف الشخصية، ومحدد للمصاريف المشتركة المخصومة من الصندوق
  receiptUrl  String?    // رابط صورة الفاتورة المرفوعة
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category   @relation(fields: [categoryId], references: [id])
  fund        JointFund? @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model ShoppingOrder {
  id          String     @id @default(uuid())
  title       String     // اسم السلعة المطلوبة
  estAmount   Decimal    @db.Decimal(12, 2) // المبلغ التقديري
  status      String     @default("pending_approval") // 'pending_approval', 'approved', 'purchased'
  requestedBy String     // معرف حساب الشريك الذي أضاف الطلب
  fundId      String
  fund        JointFund  @relation(fields: [fundId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Budget {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(12, 2)
  period     String   @default("monthly") // 'monthly', 'weekly', 'yearly'
  startDate  DateTime
  endDate    DateTime
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, startDate])
}
